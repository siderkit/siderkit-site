// Cloudflare Workers static-asset deployment. The site is fully static, so
// this Worker has no script: requests are served straight from `dist` and no
// Worker code is ever invoked (no request billing). `not_found_handling`
// serves the generated 404 page; `html_handling` keeps the trailing-slash
// routing the site's routes require. Logs stay off because the Worker never
// executes.
{
  "name": "siderkit-site",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": false
  }
}
