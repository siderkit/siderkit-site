---
import Icon from '../../../ui/Icon.astro';
import { formatDate, formatSize, release } from '../data/releases';
import { useBreakMessages } from '../i18n/ui';
import type { Locale } from '../../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useBreakMessages(locale);
const isPublished = release.published && release.windows !== null;
const isPrerelease = release.version.includes('-');
const badgeLabel = isPrerelease
  ? t.labels.releaseCandidate
  : isPublished
    ? t.labels.signedBuild
    : t.labels.releaseCandidate;
const note = isPublished
  ? isPrerelease
    ? t.product.publishedCandidateNote
    : t.product.publishedNote
  : t.product.releaseCandidateNote;
const windowsUrl = isPublished && release.windows ? release.windows.url : release.github;
const windowsLabel = isPublished ? t.product.downloadWindows : t.product.downloadGithub;
const macUrl = release.macos?.url ?? release.github;
const linuxUrl = release.linux?.url ?? release.github;
---

<section class="l-download" id="download" aria-labelledby="download-title">
  <div class="l-break-download-head">
    <div>
      <p class="l-break-download-eyebrow">{t.product.eyebrow}</p>
      <h2 class="l-break-download-title" id="download-title">{t.product.downloadTitle}</h2>
    </div>
    <span class:list={['l-break-download-status', isPublished ? 'is-published' : 'is-candidate']}>
      {badgeLabel}
    </span>
  </div>

  <a
    class="sk-button sk-button--primary l-break-download-primary"
    href={windowsUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name={isPublished ? 'download' : 'github'} size="sm" />
    {windowsLabel}
    <span class="sk-visually-hidden">({t.labels.opensInNewTab})</span>
  </a>

  <p class="l-break-download-meta">{t.product.windowsMeta}</p>

  <dl class="l-break-download-facts">
    <div>
      <dt>{t.product.versionLabel}</dt>
      <dd>{release.version}</dd>
    </div>
    <div>
      <dt>{t.product.releasedLabel}</dt>
      <dd>{formatDate(release.pubDate, locale)}</dd>
    </div>
    {
      release.windows && (
        <>
          <div>
            <dt>{t.product.sizeLabel}</dt>
            <dd>{formatSize(release.windows.size, locale)}</dd>
          </div>
          <div class="l-break-download-hash">
            <dt>{t.product.checksumLabel}</dt>
            <dd>
              <code>{release.windows.sha256}</code>
            </dd>
          </div>
        </>
      )
    }
  </dl>

  <div class="l-break-download-alternatives">
    {
      release.macos && (
        <a href={macUrl} target="_blank" rel="noopener noreferrer">
          <span>{t.product.downloadMac}</span>
          <Icon name="external" size="sm" />
        </a>
      )
    }
    {
      release.linux && (
        <a href={linuxUrl} target="_blank" rel="noopener noreferrer">
          <span>{t.product.downloadLinux}</span>
          <Icon name="external" size="sm" />
        </a>
      )
    }
    <a href={release.github} target="_blank" rel="noopener noreferrer">
      <span>{t.product.downloadGithub}</span>
      <Icon name="external" size="sm" />
    </a>
  </div>

  <p class="l-break-download-note">
    {note}
  </p>
  <p class="l-break-download-checksum">{t.product.checksumNote}</p>
</section>

<style>
  .l-download {
    padding: clamp(var(--sk-space-lg), 4vw, var(--sk-space-2xl));
    border: var(--sk-edge) solid hsl(var(--sk-color-line));
    border-radius: var(--sk-radius-lg);
    background: hsl(var(--sk-color-paper-raised) / 0.82);
    box-shadow: var(--sk-shadow-card);
  }

  .l-break-download-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sk-space-md);
  }

  .l-break-download-eyebrow {
    color: hsl(var(--sk-color-accent-strong));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    text-transform: uppercase;
  }

  .l-break-download-title {
    margin-block-start: var(--sk-space-xs);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-2xl);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-snug);
  }

  .l-break-download-status {
    flex: none;
    padding: var(--sk-space-2xs) var(--sk-space-sm);
    border-radius: var(--sk-radius-full);
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    line-height: var(--sk-leading-snug);
    text-transform: uppercase;
  }

  .l-break-download-status.is-candidate {
    background: hsl(var(--sk-color-accent-soft));
    color: hsl(var(--sk-color-accent-strong));
  }

  .l-break-download-status.is-published {
    background: hsl(var(--sk-color-brand-soft));
    color: hsl(var(--sk-color-brand-strong));
  }

  .l-break-download-primary {
    inline-size: 100%;
    margin-block-start: var(--sk-space-lg);
  }

  .l-break-download-meta {
    margin-block-start: var(--sk-space-sm);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-xs);
    text-align: center;
  }

  .l-break-download-facts {
    display: grid;
    gap: var(--sk-space-md);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: var(--sk-space-lg);
    padding-block: var(--sk-space-md);
    border-block: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-download-facts dt {
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-xs);
    letter-spacing: var(--sk-tracking-wide);
    text-transform: uppercase;
  }

  .l-break-download-facts dd {
    margin: var(--sk-space-3xs) 0 0;
    color: hsl(var(--sk-color-ink-soft));
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-medium);
  }

  .l-break-download-facts code {
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
  }

  .l-break-download-hash {
    grid-column: 1 / -1;
  }

  .l-break-download-hash code {
    display: block;
    line-height: var(--sk-leading-normal);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .l-break-download-alternatives {
    display: flex;
    flex-direction: column;
    gap: var(--sk-space-xs);
    margin-block-start: var(--sk-space-md);
  }

  .l-break-download-alternatives a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sk-space-sm);
    padding: var(--sk-space-xs) 0;
    color: hsl(var(--sk-color-ink-soft));
    font-size: var(--sk-text-sm);
    text-decoration: none;
  }

  .l-break-download-alternatives a:hover {
    color: hsl(var(--sk-color-brand));
  }

  .l-break-download-note {
    margin-block-start: var(--sk-space-md);
    padding: var(--sk-space-sm);
    border-radius: var(--sk-radius-sm);
    background: hsl(var(--sk-color-paper-sunk) / 0.65);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-xs);
    line-height: var(--sk-leading-normal);
  }

  .l-break-download-checksum {
    margin-block-start: var(--sk-space-sm);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-xs);
  }

  @media (max-width: 639px) {
    .l-break-download-head {
      flex-direction: column;
    }

    .l-break-download-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
