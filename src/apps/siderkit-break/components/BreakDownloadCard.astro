---
import Icon from '../../../ui/Icon.astro';
import { formatDate, formatSize, release } from '../data/releases';
import { useBreakMessages } from '../i18n/ui';
import type { Locale } from '../../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useBreakMessages(locale);
const isPrerelease = release.version.includes('-');
const badgeLabel = isPrerelease ? t.labels.releaseCandidate : t.labels.signedBuild;
const windowsUrl = release.published && release.windows ? release.windows.url : release.github;
const windowsLabel = release.published && release.windows
  ? t.product.download.downloadWindows
  : t.product.download.downloadGithub;
---

<section class="l-break-download" id="download" aria-labelledby="download-title">
  <div class="sk-container">
    <div class="l-break-download-panel">
      <div class="l-break-download-copy">
        <p class="l-break-download-eyebrow">{t.product.download.eyebrow}</p>
        <h2 class="l-break-download-title" id="download-title">{t.product.download.title}</h2>
        <p class="l-break-download-lead">{t.product.download.lead}</p>
        <p class="l-break-download-note">{t.product.download.note}</p>
        <p class="l-break-download-checksum-note">{t.product.download.checksumNote}</p>
      </div>

      <div class="l-break-download-action">
        <span class="l-break-download-badge">{badgeLabel}</span>
        <p class="l-break-download-platform">{t.product.hero.platform}</p>

        <a
          class="sk-button l-break-download-primary"
          href={windowsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={release.published && release.windows ? 'download' : 'github'} size="sm" />
          {windowsLabel}
          <span class="sk-visually-hidden">({t.labels.opensInNewTab})</span>
        </a>

        <a
          class="sk-button l-break-download-secondary"
          href={release.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.product.download.downloadGithub}
          <Icon name="external" size="sm" />
        </a>

        <p class="l-break-download-meta">{t.product.download.windowsMeta}</p>

        {
          (release.macos || release.linux) && (
            <div class="l-break-download-alternatives">
              {release.macos && (
                <a href={release.macos.url} target="_blank" rel="noopener noreferrer">
                  <span>{t.product.download.downloadMac}</span>
                  <Icon name="external" size="sm" />
                </a>
              )}
              {release.linux && (
                <a href={release.linux.url} target="_blank" rel="noopener noreferrer">
                  <span>{t.product.download.downloadLinux}</span>
                  <Icon name="external" size="sm" />
                </a>
              )}
            </div>
          )
        }
      </div>

      <dl class="l-break-download-facts">
        <div>
          <dt>{t.product.download.versionLabel}</dt>
          <dd>{release.version}</dd>
        </div>
        <div>
          <dt>{t.product.download.releasedLabel}</dt>
          <dd>{formatDate(release.pubDate, locale)}</dd>
        </div>
        <div>
          <dt>{t.product.download.sizeLabel}</dt>
          <dd>{release.windows ? formatSize(release.windows.size, locale) : '—'}</dd>
        </div>
        <div class="l-break-download-hash">
          <dt>{t.product.download.checksumLabel}</dt>
          <dd>
            <code>{release.windows ? release.windows.sha256 : '—'}</code>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .l-break-download {
    padding-block: var(--sk-space-4xl);
  }

  .l-break-download-panel {
    display: grid;
    gap: var(--sk-space-2xl);
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    padding: clamp(var(--sk-space-xl), 4.5vw, var(--sk-space-3xl));
    border: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
    border-radius: var(--sk-radius-xl);
    background: var(--sk-gradient-break-band);
    color: hsl(var(--sk-color-break-on-deep));
    box-shadow: var(--sk-shadow-stage);
  }

  .l-break-download-eyebrow {
    color: hsl(var(--sk-color-break-glow));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    text-transform: uppercase;
  }

  .l-break-download-title {
    max-inline-size: 18ch;
    margin-block-start: var(--sk-space-sm);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-section);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-tight);
    text-wrap: balance;
  }

  .l-break-download-lead {
    max-inline-size: var(--sk-reading);
    margin-block-start: var(--sk-space-md);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-lg);
    line-height: var(--sk-leading-normal);
  }

  .l-break-download-note {
    max-inline-size: var(--sk-reading);
    margin-block-start: var(--sk-space-xl);
    padding-block-start: var(--sk-space-md);
    border-block-start: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-sm);
    line-height: var(--sk-leading-normal);
  }

  .l-break-download-checksum-note {
    margin-block-start: var(--sk-space-sm);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-xs);
    line-height: var(--sk-leading-normal);
  }

  .l-break-download-action {
    align-self: center;
    padding-inline-start: var(--sk-space-2xl);
    border-inline-start: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
  }

  .l-break-download-badge {
    display: inline-flex;
    padding: var(--sk-space-2xs) var(--sk-space-sm);
    border-radius: var(--sk-radius-full);
    background: hsl(var(--sk-color-break-glow) / 0.14);
    color: hsl(var(--sk-color-break-glow));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    line-height: var(--sk-leading-snug);
    text-transform: uppercase;
  }

  .l-break-download-platform {
    margin-block-start: var(--sk-space-sm);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
  }

  .l-break-download-primary {
    inline-size: 100%;
    margin-block-start: var(--sk-space-md);
    background: hsl(var(--sk-color-break-cream));
    color: hsl(var(--sk-color-break-deep));
    box-shadow: var(--sk-shadow-card);
  }

  .l-break-download-primary:hover {
    background: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-download-secondary {
    inline-size: 100%;
    margin-block-start: var(--sk-space-xs);
    border-color: hsl(var(--sk-color-break-line-deep));
    color: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-download-secondary:hover {
    border-color: hsl(var(--sk-color-break-glow) / 0.6);
    background: hsl(var(--sk-color-break-glow) / 0.1);
  }

  .l-break-download-meta {
    margin-block-start: var(--sk-space-md);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-xs);
    line-height: var(--sk-leading-normal);
    text-align: center;
  }

  .l-break-download-alternatives {
    display: flex;
    flex-direction: column;
    gap: var(--sk-space-xs);
    margin-block-start: var(--sk-space-sm);
  }

  .l-break-download-alternatives a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sk-space-sm);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-sm);
    text-decoration: none;
  }

  .l-break-download-alternatives a:hover {
    color: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-download-facts {
    display: grid;
    gap: var(--sk-space-lg);
    grid-column: 1 / -1;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block-start: var(--sk-space-lg);
    border-block-start: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
  }

  .l-break-download-hash {
    grid-column: 1 / -1;
    padding-block-start: var(--sk-space-sm);
    border-block-start: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
  }

  .l-break-download-facts dt {
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-xs);
    letter-spacing: var(--sk-tracking-wide);
    text-transform: uppercase;
  }

  .l-break-download-facts dd {
    margin: var(--sk-space-3xs) 0 0;
    color: hsl(var(--sk-color-break-on-deep));
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-medium);
  }

  .l-break-download-facts code {
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
    line-height: var(--sk-leading-normal);
    overflow-wrap: anywhere;
    user-select: all;
  }

  @media (max-width: 1023px) {
    .l-break-download-panel {
      grid-template-columns: 1fr;
    }

    .l-break-download-action {
      padding-block-start: var(--sk-space-xl);
      padding-inline-start: 0;
      border-block-start: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
      border-inline-start: 0;
    }

    .l-break-download-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .l-break-download-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
