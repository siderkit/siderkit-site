---
import breakMark from '../assets/break-mark.png';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
---

<!--
  Reuses the generated application icon verbatim
  (siderkit-break/src-tauri/icons/icon.png, produced by `pnpm tauri icon`).
  Never redraw or recolour it here; replace the PNG when the app icon changes.
-->
<img
  class:list={['l-break-mark', `is-${size}`, className]}
  src={breakMark.src}
  width={breakMark.width}
  height={breakMark.height}
  alt=""
  aria-hidden="true"
  decoding="async"
/>

<style>
  .l-break-mark {
    /* The icon canvas carries transparent padding; 1.2 keeps the droplet
       visually the same size as the previous 64-unit mark. */
    /* Physical properties: legacy kernels (WeChat) drop inline-size and would
       fall back to the PNG's intrinsic size. */
    width: calc(var(--sk-space-xl) * 1.2);
    height: auto;
    flex: none;
    filter: drop-shadow(0 var(--sk-space-3xs) var(--sk-space-2xs) hsl(150 60% 24% / 0.28));
  }

  .l-break-mark.is-sm {
    width: calc(var(--sk-icon-md) * 1.2);
  }

  .l-break-mark.is-lg {
    width: calc(var(--sk-space-2xl) * 1.2);
  }
</style>
