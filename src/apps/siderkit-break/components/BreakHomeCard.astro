---
import { Image } from 'astro:assets';
import Icon from '../../../ui/Icon.astro';
import BreakMark from './BreakMark.astro';
import mainFocus from '../assets/screens/main-focus.png';
import { release } from '../data/releases';
import { localizedPath, type Locale } from '../../../i18n/config';
import { breakApp } from '../manifest';
import { useBreakMessages } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useBreakMessages(locale);
const productHref = localizedPath(locale, breakApp.route);
---

<article class="l-break-home-card">
  <div class="l-break-home-card-shot">
    <Image
      src={mainFocus}
      alt={t.homeCard.windowAlt}
      widths={[240, 360, 480]}
      sizes="(max-width: 639px) 14rem, 12rem"
      loading="lazy"
      quality={86}
    />
  </div>

  <div class="l-break-home-card-main">
    <div class="l-break-home-card-brand">
      <BreakMark size="sm" />
      <span class="l-break-home-card-name">{t.product.eyebrow}</span>
      <span class="l-break-home-card-badge">{t.homeCard.eyebrow}</span>
    </div>

    <h3>{t.homeCard.title}</h3>
    <p class="l-break-home-card-lead">{t.homeCard.lead}</p>

    <div class="l-break-home-card-foot">
      <p>v{release.version} · {t.product.hero.platform} · {t.homeCard.note}</p>
      <a href={productHref}>
        {t.homeCard.primaryCta}
        <Icon name="arrow-right" size="sm" />
      </a>
    </div>
  </div>
</article>

<style>
  .l-break-home-card {
    display: grid;
    align-items: start;
    gap: var(--sk-space-lg);
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    padding: var(--sk-space-lg);
    padding: clamp(var(--sk-space-lg), 2.5vw, var(--sk-space-xl));
    border: var(--sk-edge) solid hsl(var(--sk-color-line));
    border-radius: var(--sk-radius-lg);
    background: hsl(var(--sk-color-paper-raised) / 0.72);
    box-shadow: var(--sk-shadow-card);
  }

  .l-break-home-card-shot {
    padding: var(--sk-space-xs);
    border: var(--sk-edge) solid hsl(var(--sk-color-line-soft));
    border-radius: var(--sk-radius-md);
    background: var(--sk-gradient-stage);
  }

  .l-break-home-card-shot img {
    width: 100%;
    height: auto;
    border-radius: var(--sk-radius-xs);
  }

  .l-break-home-card-brand {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sk-space-xs);
  }

  .l-break-home-card-name {
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-semibold);
    line-height: var(--sk-leading-snug);
  }

  .l-break-home-card-badge {
    padding: var(--sk-space-xs) var(--sk-space-xs);
    border-radius: var(--sk-radius-full);
    background: hsl(var(--sk-color-break-forest-soft));
    color: hsl(var(--sk-color-break-forest-strong));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    line-height: var(--sk-leading-none);
    text-transform: uppercase;
  }

  .l-break-home-card h3 {
    margin-top: var(--sk-space-sm);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-xl);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-snug);
  }

  .l-break-home-card-lead {
    margin-top: var(--sk-space-xs);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-sm);
    line-height: var(--sk-leading-normal);
  }

  .l-break-home-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sk-space-sm);
    margin-top: var(--sk-space-md);
    padding-top: var(--sk-space-sm);
    border-top: var(--sk-edge) solid hsl(var(--sk-color-line-soft));
  }

  .l-break-home-card-foot p {
    color: hsl(var(--sk-color-muted));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
    line-height: var(--sk-leading-normal);
  }

  .l-break-home-card-foot a {
    display: inline-flex;
    align-items: center;
    gap: var(--sk-space-xs);
    color: hsl(var(--sk-color-break-forest-strong));
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .l-break-home-card-foot a:hover {
    gap: var(--sk-space-sm);
  }

  @media (max-width: 639px) {
    .l-break-home-card {
      grid-template-columns: 1fr;
    }

    .l-break-home-card-shot {
      max-width: 14rem;
    }
  }
</style>
