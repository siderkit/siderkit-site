---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreakDownloadConsole from '../components/BreakDownloadConsole.astro';
import BreakMark from '../components/BreakMark.astro';
import Icon from '../../../ui/Icon.astro';
import breakRunning from '../assets/screens/break-running.png';
import breakDone from '../assets/screens/break-done.png';
import insightsShot from '../assets/screens/insights.png';
import mainFocus from '../assets/screens/main-focus.png';
import { changelog } from '../data/changelog';
import { formatDate, primaryDownloadUrl, release } from '../data/releases';
import { absoluteUrl, localizedPath, type Locale } from '../../../i18n/config';
import { breakApp } from '../manifest';
import { breakLinks } from '../links';
import { useBreakMessages } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useBreakMessages(locale);
const changelogHref = localizedPath(locale, breakApp.changelogRoute);
const latest = changelog[0];

const dayImages = [mainFocus, breakRunning, breakDone];
const featureIcons = ['timer', 'window', 'bell', 'archive', 'chart', 'refresh'] as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Siderkit Break',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS, Linux',
  softwareVersion: release.version,
  description: t.meta.productDescription,
  url: absoluteUrl(localizedPath(locale, breakApp.route)),
  downloadUrl: primaryDownloadUrl,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  locale={locale}
  path={breakApp.route}
  title={t.meta.productTitle}
  description={t.meta.productDescription}
  image="/og/siderkit-break.png"
  imageAlt={t.meta.ogAlt}
  schema={schema}
>
  <section class="l-break-product-hero">
    <div class="sk-container">
      <nav class="l-break-product-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(locale, '/')}>{t.labels.brand}</a>
        <span aria-hidden="true">/</span>
        <span>{t.product.eyebrow}</span>
      </nav>

      <div class="l-break-product-hero-grid">
        <div class="l-break-product-hero-copy">
          <div class="l-break-product-brand">
            <BreakMark size="md" />
            <p class="l-break-product-kicker">{t.product.hero.kicker}</p>
          </div>

          <h1 class="l-break-product-title">{t.product.hero.title}</h1>
          <p class="l-break-product-hero-lead">{t.product.hero.lead}</p>

          <BreakDownloadConsole locale={locale} />

          <a class="l-break-product-hero-link" href="#day">
            {t.product.hero.secondaryCta}
            <Icon name="chevron-down" size="sm" />
          </a>
        </div>

        <div class="l-break-product-hero-stage">
          <span class="l-break-product-hero-ring" aria-hidden="true"></span>
          <div class="l-break-product-hero-window">
            <Image
              src={mainFocus}
              alt={t.product.hero.windowAlt}
              widths={[480, 720, 960]}
              sizes="(max-width: 1023px) 92vw, 620px"
              loading="eager"
              quality={90}
            />
          </div>
          <div class="l-break-product-hero-card">
            <Image
              src={breakRunning}
              alt={t.product.hero.cardAlt}
              widths={[180, 260, 360]}
              sizes="(max-width: 639px) 56vw, 260px"
              loading="eager"
              quality={90}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sk-section l-break-product-day" id="day" aria-labelledby="day-title">
    <div class="sk-container">
      <div class="l-break-product-head">
        <div>
          <p class="sk-eyebrow">{t.product.day.eyebrow}</p>
          <h2 class="sk-title" id="day-title">{t.product.day.title}</h2>
        </div>
        <p class="sk-lead">{t.product.day.lead}</p>
      </div>

      <ol class="l-break-product-day-list">
        {
          t.product.day.steps.map((step, index) => (
            <li class="l-break-product-day-step">
              <div class="l-break-product-day-marker">
                <time>{step.time}</time>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="l-break-product-day-copy">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <figure class:list={['l-break-product-day-visual', index === 0 ? 'is-window' : 'is-card']}>
                <Image
                  src={dayImages[index]}
                  alt={step.alt}
                  widths={index === 0 ? [480, 720, 960] : [220, 320, 440]}
                  sizes={
                    index === 0
                      ? '(max-width: 1023px) 92vw, 640px'
                      : '(max-width: 1023px) 64vw, 380px'
                  }
                  loading="lazy"
                  quality={88}
                />
                <figcaption>{step.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sk-section l-break-product-insights" aria-labelledby="insights-title">
    <div class="sk-container l-break-product-insights-grid">
      <div class="l-break-product-insights-copy">
        <p class="sk-eyebrow">{t.product.insights.eyebrow}</p>
        <h2 class="sk-title" id="insights-title">{t.product.insights.title}</h2>
        <p class="sk-lead">{t.product.insights.lead}</p>

        <ul class="l-break-product-insights-points">
          {
            t.product.insights.points.map((point) => (
              <li>
                <Icon name="check" size="sm" />
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="l-break-product-insights-figure">
        <Image
          src={insightsShot}
          alt={t.product.insights.alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 1023px) 92vw, 660px"
          loading="lazy"
          quality={88}
        />
        <figcaption>{t.product.insights.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="sk-section l-break-product-features" aria-labelledby="features-title">
    <div class="sk-container">
      <div class="l-break-product-head l-break-product-head-dark">
        <div>
          <p class="sk-eyebrow">{t.product.features.eyebrow}</p>
          <h2 class="sk-title" id="features-title">{t.product.features.title}</h2>
        </div>
        <p class="sk-lead">{t.product.features.lead}</p>
      </div>

      <ul class="l-break-product-feature-grid">
        {
          t.product.features.items.map((feature, index) => (
            <li>
              <span class="l-break-product-feature-icon" aria-hidden="true">
                <Icon name={featureIcons[index]} size="md" />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="l-break-product-fineprint" aria-labelledby="fineprint-title">
    <div class="sk-container">
      <details class="l-break-product-details">
        <summary>
          <span id="fineprint-title">{t.product.download.requirementsSummary}</span>
          <Icon name="chevron-down" size="sm" />
        </summary>

        <div class="l-break-product-details-body">
          <p class="l-break-product-details-lead">{t.product.download.requirementsLead}</p>

          <div class="l-break-product-table-wrap">
            <table class="l-break-product-table">
              <caption class="sk-visually-hidden">{t.product.download.requirementsTitle}</caption>
              <thead>
                <tr>
                  <th scope="col">{t.product.download.tablePlatform}</th>
                  <th scope="col">{t.product.download.tableMinimum}</th>
                  <th scope="col">{t.product.download.tableArtifacts}</th>
                  <th scope="col">{t.product.download.tableStatus}</th>
                </tr>
              </thead>
              <tbody>
                {
                  t.product.download.requirements.map((row) => (
                    <tr>
                      <th scope="row">{row.platform}</th>
                      <td>{row.minimum}</td>
                      <td>{row.artifacts}</td>
                      <td>{row.status}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="l-break-product-table-note">{t.product.download.requirementsNote}</p>

          <div class="l-break-product-details-grid">
            <div>
              <h3>{t.product.download.installTitle}</h3>
              <p>{t.product.download.installBody}</p>
            </div>
            <div>
              <h3>{t.product.download.updateTitle}</h3>
              <p>{t.product.download.updateBody}</p>
            </div>
            <div>
              <h3>{t.product.download.privacyTitle}</h3>
              <p>{t.product.download.privacyBody}</p>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="sk-section--tight l-break-product-faq" aria-labelledby="faq-title">
    <div class="sk-container">
      <p class="sk-eyebrow">{t.product.faq.eyebrow}</p>
      <h2 class="sk-title" id="faq-title">{t.product.faq.title}</h2>
      <div class="l-break-product-faq-list">
        {
          t.product.faq.items.map((item) => (
            <details class="l-break-product-faq-item">
              <summary>
                <span>{item.question}</span>
                <Icon name="chevron-down" size="sm" />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sk-section--tight l-break-product-closing">
    <div class="sk-container">
      <div class="l-break-product-changelog">
        <div class="l-break-product-changelog-copy">
          <p class="sk-eyebrow">{t.product.closing.changelogEyebrow}</p>
          <h2 class="sk-title">{t.product.closing.changelogTitle}</h2>
          <p class="sk-lead">{t.product.closing.changelogLead}</p>
          {
            latest && (
              <p class="l-break-product-release-line">
                <span>{latest.version}</span>
                <span aria-hidden="true">·</span>
                <time datetime={latest.date}>{formatDate(latest.date, locale)}</time>
              </p>
            )
          }
          <a class="sk-text-link l-break-product-inline-link" href={changelogHref}>
            {t.product.closing.changelogCta}
            <Icon name="arrow-right" size="sm" />
          </a>
        </div>

        {
          latest && (
            <div class="l-break-product-release-notes">
              {latest.sections
                .filter((section) => section.kind === 'added' || section.kind === 'changed')
                .map((section) => (
                  <div>
                    <h3>{t.changelog.sections[section.kind]}</h3>
                    <ul>
                      {(section.items[locale] ?? section.items.en).slice(0, 3).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
            </div>
          )
        }
      </div>

      <div class="l-break-product-source">
        <div>
          <h2>{t.product.closing.sourceTitle}</h2>
          <p>{t.product.closing.sourceBody}</p>
        </div>
        <a class="sk-button sk-button--ghost" href={breakLinks.repo} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size="sm" />
          {t.product.closing.sourceCta}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .l-break-product-hero {
    position: relative;
    padding-top: var(--sk-space-lg);
    padding-bottom: var(--sk-space-4xl);
    overflow: clip;
    background: var(--sk-gradient-break-hero);
    color: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-product-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--sk-space-xs);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-xs);
  }

  .l-break-product-breadcrumb a {
    text-decoration: none;
  }

  .l-break-product-breadcrumb a:hover {
    color: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-product-hero-grid {
    display: grid;
    align-items: center;
    gap: var(--sk-space-3xl);
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    margin-top: var(--sk-space-2xl);
  }

  .l-break-product-brand {
    display: flex;
    align-items: center;
    gap: var(--sk-space-sm);
  }

  .l-break-product-kicker {
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    line-height: var(--sk-leading-snug);
    text-transform: uppercase;
  }

  .l-break-product-title {
    max-width: 13ch;
    margin-top: var(--sk-space-lg);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-hero);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-tight);
    text-wrap: balance;
  }

  .l-break-product-hero-lead {
    max-width: var(--sk-reading);
    margin-top: var(--sk-space-lg);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-lg);
    line-height: var(--sk-leading-normal);
    text-wrap: pretty;
  }

  .l-break-product-hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sk-space-xs);
    margin-top: var(--sk-space-md);
    color: hsl(var(--sk-color-break-on-deep-soft));
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-medium);
    text-decoration: none;
  }

  .l-break-product-hero-link:hover {
    color: hsl(var(--sk-color-break-on-deep));
    text-decoration: underline;
  }

  .l-break-product-hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-top: var(--sk-space-xl);
    padding-bottom: var(--sk-space-xl);
    isolation: isolate;
  }

  .l-break-product-hero-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 96%;
    aspect-ratio: 1;
    border: var(--sk-edge) solid hsl(var(--sk-color-break-glow) / 0.16);
    border-radius: var(--sk-radius-full);
    transform: translate(-50%, -50%);
  }

  .l-break-product-hero-ring::after {
    content: '';
    position: absolute;
    inset: 11%;
    border: var(--sk-edge) solid hsl(var(--sk-color-break-glow) / 0.1);
    border-radius: var(--sk-radius-full);
  }

  .l-break-product-hero-window {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 var(--sk-space-lg) var(--sk-space-2xl) hsl(var(--sk-color-break-deeper) / 0.45));
  }

  .l-break-product-hero-window img {
    width: 100%;
    height: auto;
    border-radius: var(--sk-radius-md);
  }

  .l-break-product-hero-card {
    position: absolute;
    z-index: 2;
    bottom: calc(var(--sk-space-3xl) * -1);
    left: calc(var(--sk-space-xl) * -1);
    width: 46%;
    filter: drop-shadow(0 var(--sk-space-md) var(--sk-space-lg) hsl(var(--sk-color-break-deeper) / 0.5));
  }

  .l-break-product-hero-card img {
    width: 100%;
    height: auto;
  }

  /* ── Section heads ──────────────────────────────────────────── */
  .l-break-product-head {
    display: grid;
    align-items: end;
    gap: var(--sk-space-xl);
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
  }

  .l-break-product-head .sk-lead {
    margin-top: 0;
  }

  .l-break-product-day .sk-eyebrow,
  .l-break-product-insights .sk-eyebrow,
  .l-break-product-closing .sk-eyebrow {
    color: hsl(var(--sk-color-break-forest-strong));
  }

  /* ── A day with Break ───────────────────────────────────────── */
  .l-break-product-day-list {
    margin-top: var(--sk-space-2xl);
  }

  .l-break-product-day-step {
    display: grid;
    align-items: center;
    gap: var(--sk-space-xl);
    grid-template-columns: minmax(0, 0.3fr) minmax(0, 0.8fr) minmax(0, 1.15fr);
    padding-top: var(--sk-space-xl);
    padding-bottom: var(--sk-space-xl);
    border-top: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-product-day-step:last-child {
    border-bottom: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-product-day-marker {
    display: flex;
    flex-direction: column;
    gap: var(--sk-space-xs);
  }

  .l-break-product-day-marker time {
    color: hsl(var(--sk-color-break-forest-strong));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xl);
    letter-spacing: var(--sk-tracking-tight);
  }

  .l-break-product-day-marker span {
    color: hsl(var(--sk-color-muted));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
    letter-spacing: var(--sk-tracking-wide);
  }

  .l-break-product-day-copy h3 {
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-2xl);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-snug);
  }

  .l-break-product-day-copy p {
    max-width: var(--sk-reading);
    margin-top: var(--sk-space-sm);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-base);
    line-height: var(--sk-leading-normal);
  }

  .l-break-product-day-visual {
    display: grid;
    place-items: center;
    padding: var(--sk-space-lg);
    padding: clamp(var(--sk-space-lg), 3vw, var(--sk-space-2xl));
    border: var(--sk-edge) solid hsl(var(--sk-color-line-soft));
    border-radius: var(--sk-radius-lg);
    background: var(--sk-gradient-break-canvas);
  }

  .l-break-product-day-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--sk-radius-sm);
  }

  .l-break-product-day-visual.is-window img {
    box-shadow: var(--sk-shadow-card);
  }

  .l-break-product-day-visual.is-card img {
    width: 76%;
    filter: drop-shadow(0 var(--sk-space-md) var(--sk-space-lg) hsl(var(--sk-color-break-deep) / 0.28));
  }

  .l-break-product-day-visual figcaption {
    margin-top: var(--sk-space-md);
    color: hsl(var(--sk-color-break-forest-strong));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
  }

  /* ── Insights ───────────────────────────────────────────────── */
  .l-break-product-insights {
    border-top: var(--sk-edge) solid hsl(var(--sk-color-line));
    border-bottom: var(--sk-edge) solid hsl(var(--sk-color-line));
    background: hsl(var(--sk-color-break-mist));
  }

  .l-break-product-insights-grid {
    display: grid;
    align-items: center;
    gap: var(--sk-space-2xl);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .l-break-product-insights-copy .sk-lead {
    max-width: var(--sk-reading);
  }

  .l-break-product-insights-points {
    display: flex;
    flex-direction: column;
    margin-top: var(--sk-space-xl);
  }

  .l-break-product-insights-points li {
    display: flex;
    align-items: flex-start;
    gap: var(--sk-space-sm);
    padding-top: var(--sk-space-md);
    padding-bottom: var(--sk-space-md);
    border-top: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-product-insights-points li:last-child {
    border-bottom: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-product-insights-points svg {
    flex: none;
    margin-top: var(--sk-space-xs);
    color: hsl(var(--sk-color-break-forest));
  }

  .l-break-product-insights-points h3 {
    font-size: var(--sk-text-base);
    font-weight: var(--sk-weight-semibold);
    line-height: var(--sk-leading-snug);
  }

  .l-break-product-insights-points p {
    margin-top: var(--sk-space-3xs);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-sm);
    line-height: var(--sk-leading-normal);
  }

  .l-break-product-insights-figure {
    padding: var(--sk-space-md);
    padding: clamp(var(--sk-space-md), 2.5vw, var(--sk-space-xl));
    border: var(--sk-edge) solid hsl(var(--sk-color-line));
    border-radius: var(--sk-radius-lg);
    background: hsl(var(--sk-color-paper-raised) / 0.7);
    box-shadow: var(--sk-shadow-card);
  }

  .l-break-product-insights-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--sk-radius-sm);
  }

  .l-break-product-insights-figure figcaption {
    margin-top: var(--sk-space-sm);
    color: hsl(var(--sk-color-muted));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
  }

  /* ── Features ───────────────────────────────────────────────── */
  .l-break-product-features {
    background: var(--sk-gradient-break-band);
    color: hsl(var(--sk-color-break-on-deep));
  }

  .l-break-product-head-dark .sk-eyebrow {
    color: hsl(var(--sk-color-break-glow));
  }

  .l-break-product-head-dark .sk-lead {
    color: hsl(var(--sk-color-break-on-deep-soft));
  }

  .l-break-product-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--sk-space-2xl);
    border-top: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
  }

  .l-break-product-feature-grid li {
    padding: var(--sk-space-xl);
    border-bottom: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
    border-left: var(--sk-edge) solid hsl(var(--sk-color-break-line-deep));
  }

