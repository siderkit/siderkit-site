---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreakMark from '../components/BreakMark.astro';
import { changelog } from '../data/changelog';
import { formatDate } from '../data/releases';
import type { Locale } from '../../../i18n/config';
import { breakApp } from '../manifest';
import { useBreakMessages } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useBreakMessages(locale);
---

<BaseLayout
  locale={locale}
  path={breakApp.changelogRoute}
  title={t.meta.changelogTitle}
  description={t.meta.changelogDescription}
  image="/og/siderkit-break.png"
  imageAlt={t.meta.ogAlt}
>
  <section class="l-break-changelog-hero">
    <div class="sk-container">
      <div class="l-break-changelog-brand">
        <BreakMark size="md" />
        <p class="sk-eyebrow">{t.changelog.eyebrow}</p>
      </div>
      <h1 class="l-break-changelog-title">{t.changelog.title}</h1>
      <p class="sk-lead">{t.changelog.lead}</p>
    </div>
  </section>

  <section class="l-break-changelog-list">
    <div class="sk-container">
      {
        changelog.length === 0 ? (
          <p class="l-break-changelog-empty">{t.changelog.empty}</p>
        ) : (
          changelog.map((entry) => (
            <article class="l-break-changelog-entry">
              <header class="l-break-changelog-entry-head">
                <h2>{entry.version}</h2>
                <time datetime={entry.date}>{formatDate(entry.date, locale)}</time>
              </header>
              <div class="l-break-changelog-sections">
                {entry.sections.map((section) => (
                  <section data-kind={section.kind}>
                    <h3>{t.changelog.sections[section.kind]}</h3>
                    <ul>
                      {section.items[locale].map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </article>
          ))
        )
      }
      <p class="l-break-changelog-note">{t.changelog.note}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .l-break-changelog-hero {
    padding-block: var(--sk-space-2xl) var(--sk-space-xl);
  }

  .l-break-changelog-title {
    margin-block-start: var(--sk-space-md);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-section);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-tight);
  }

  .l-break-changelog-brand {
    display: flex;
    align-items: center;
    gap: var(--sk-space-sm);
  }

  .l-break-changelog-brand .sk-eyebrow {
    margin: 0;
  }

  .l-break-changelog-list {
    padding-block: var(--sk-space-xl) var(--sk-space-4xl);
  }

  .l-break-changelog-entry {
    display: grid;
    gap: var(--sk-space-2xl);
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    padding-block: var(--sk-space-2xl);
    border-block-start: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-break-changelog-entry-head {
    position: sticky;
    inset-block-start: calc(var(--sk-header-height) + var(--sk-space-lg));
    align-self: start;
  }

  .l-break-changelog-entry-head h2 {
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-2xl);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-snug);
  }

  .l-break-changelog-entry-head time {
    display: block;
    margin-block-start: var(--sk-space-xs);
    color: hsl(var(--sk-color-muted));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
  }

  .l-break-changelog-sections {
    display: grid;
    gap: var(--sk-space-xl);
  }

  .l-break-changelog-sections h3 {
    color: hsl(var(--sk-color-accent-strong));
    font-size: var(--sk-text-xs);
    font-weight: var(--sk-weight-semibold);
    letter-spacing: var(--sk-tracking-wide);
    text-transform: uppercase;
  }

  .l-break-changelog-sections section[data-kind='known'] h3 {
    color: hsl(var(--sk-color-muted));
  }

  .l-break-changelog-sections ul {
    display: flex;
    flex-direction: column;
    gap: var(--sk-space-xs);
    margin-block-start: var(--sk-space-sm);
  }

  .l-break-changelog-sections li {
    position: relative;
    padding-inline-start: var(--sk-space-md);
    color: hsl(var(--sk-color-ink-soft));
    font-size: var(--sk-text-sm);
    line-height: var(--sk-leading-normal);
  }

  .l-break-changelog-sections li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.72em;
    inset-inline-start: 0;
    inline-size: var(--sk-space-2xs);
    block-size: var(--sk-space-2xs);
    border-radius: var(--sk-radius-full);
    background: hsl(var(--sk-color-accent));
  }

  .l-break-changelog-sections section[data-kind='known'] li::before {
    background: hsl(var(--sk-color-muted));
  }

  .l-break-changelog-empty {
    color: hsl(var(--sk-color-muted));
  }

  .l-break-changelog-note {
    margin-block-start: var(--sk-space-2xl);
    padding-block-start: var(--sk-space-lg);
    border-block-start: var(--sk-edge) solid hsl(var(--sk-color-line));
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-xs);
  }

  @media (max-width: 767px) {
    .l-break-changelog-entry {
      grid-template-columns: 1fr;
      gap: var(--sk-space-lg);
    }

    .l-break-changelog-entry-head {
      position: static;
    }
  }
</style>
