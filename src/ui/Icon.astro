---
type IconName =
  | 'arrow-right'
  | 'download'
  | 'external'
  | 'github'
  | 'globe'
  | 'check'
  | 'chevron-down'
  | 'timer'
  | 'window'
  | 'bell'
  | 'archive'
  | 'chart'
  | 'refresh';

interface Props {
  name: IconName;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;
const sizeVar = `var(--sk-icon-${size})`;
---

<svg
  class={className}
  width={sizeVar}
  height={sizeVar}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>}
  {name === 'download' && <><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></>}
  {name === 'external' && <><path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" /></>}
  {name === 'github' && <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z" /></>}
  {name === 'check' && <path d="m4 12 5 5L20 6" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'timer' && <><path d="M10 2h4" /><path d="m12 14 3-3" /><circle cx="12" cy="14" r="8" /></>}
  {
    name === 'window' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 9h18" />
        <path d="M7 7h.01" />
      </>
    )
  }
  {
    name === 'bell' && (
      <>
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
      </>
    )
  }
  {
    name === 'archive' && (
      <>
        <rect x="3" y="4" width="18" height="4" rx="1" />
        <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
        <path d="M10 12h4" />
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path d="M4 20V10" />
        <path d="M10 20V4" />
        <path d="M16 20v-7" />
        <path d="M22 20H2" />
      </>
    )
  }
  {
    name === 'refresh' && (
      <>
        <path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-7.5-3.9" />
        <path d="M3 12a9 9 0 0 1 9-9 9 9 0 0 1 7.5 3.9" />
        <path d="M21 3v6h-6" />
        <path d="M3 21v-6h6" />
      </>
    )
  }
</svg>
