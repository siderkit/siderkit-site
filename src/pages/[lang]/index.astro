---
import HomeView from '../../brand/views/HomeView.astro';
import BreakHomeCard from '../../apps/siderkit-break/components/BreakHomeCard.astro';
import { locales, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { lang: locale } }));
}

const locale = Astro.params.lang as Locale;
---

<HomeView locale={locale}>
  <BreakHomeCard slot="apps" locale={locale} />
</HomeView>
