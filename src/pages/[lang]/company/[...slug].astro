---
import CompanyView from '../../../brand/views/CompanyView.astro';
import { locales, type Locale } from '../../../i18n/config';

type CompanyPage = 'about' | 'contact';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'en')
    .flatMap((locale) =>
      (['about', 'contact'] as const).map((page) => ({
        params: { lang: locale, slug: page },
        props: { page },
      })),
    );
}

const { page } = Astro.props as { page: CompanyPage };
const locale = Astro.params.lang as Locale;
---

<CompanyView locale={locale} page={page} />
