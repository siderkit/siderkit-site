---
import LegalView from '../../../brand/views/LegalView.astro';
import { locales, type Locale } from '../../../i18n/config';

type LegalPage = 'privacy' | 'terms' | 'licenses' | 'security';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'en')
    .flatMap((locale) =>
      (['privacy', 'terms', 'licenses', 'security'] as const).map((page) => ({
        params: { lang: locale, slug: page },
        props: { page },
      })),
    );
}

const { page } = Astro.props as { page: LegalPage };
const locale = Astro.params.lang as Locale;
---

<LegalView locale={locale} page={page} />
