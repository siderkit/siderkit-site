---
import BrandMark from '../BrandMark.astro';

const { siteTitle, locale } = Astro.locals.starlightRoute;
const homeHref = !locale || locale === 'root' || locale === 'en' ? '/' : `/${locale}/`;
---

<a href={homeHref} class="site-title sl-flex" aria-label={`${siteTitle} — Siderkit home`}>
  <BrandMark size="sm" class="l-docs-title-mark" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    min-width: 0;
    color: var(--sl-color-text);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-title span {
    overflow: hidden;
  }
</style>
