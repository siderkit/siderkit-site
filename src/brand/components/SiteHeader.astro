---
import LanguagePicker from './LanguagePicker.astro';
import Wordmark from './Wordmark.astro';
import { docsPath, localizedPath, type Locale } from '../../i18n/config';
import { routes } from '../../site/routes';
import { siteLinks } from '../../site/links';
import { useBrandMessages } from '../i18n/ui';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useBrandMessages(locale);
const onDocs = path.startsWith(routes.docs);
const onAbout = path.startsWith(routes.about);
const languagePath = path.startsWith(routes.notFound) ? routes.home : path;
---

<header class="l-site-header">
  <div class="sk-container l-site-header-inner">
    <Wordmark locale={locale} />

    <nav class="l-site-nav" aria-label={t.common.brand}>
      <a href={docsPath(locale)} class="l-site-nav-link" aria-current={onDocs ? 'page' : undefined}>
        {t.nav.docs}
      </a>
      <a href={localizedPath(locale, routes.about)} class="l-site-nav-link" aria-current={onAbout ? 'page' : undefined}>
        {t.nav.about}
      </a>
      <a
        href={siteLinks.org}
        class="l-site-nav-link l-site-nav-source"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.nav.source}
        <span class="sk-visually-hidden">({t.common.opensInNewTab})</span>
      </a>
    </nav>

    <div class="l-site-header-actions">
      <LanguagePicker locale={locale} path={languagePath} />
    </div>
  </div>
</header>

<style>
  .l-site-header {
    position: sticky;
    top: 0;
    z-index: var(--sk-z-header);
    border-bottom: var(--sk-edge) solid hsl(var(--sk-color-line) / 0.75);
    background: hsl(var(--sk-color-paper) / 0.82);
    backdrop-filter: blur(var(--sk-space-sm));
  }

  .l-site-header-inner {
    display: flex;
    align-items: center;
    gap: var(--sk-space-lg);
    min-height: var(--sk-header-height);
  }

  .l-site-nav {
    display: flex;
    align-items: center;
    gap: var(--sk-space-lg);
    /* Physical margin: legacy kernels drop margin-inline-start. */
    margin-left: auto;
  }

  :global([dir='rtl']) .l-site-nav {
    margin-left: 0;
    margin-right: auto;
  }

  .l-site-nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sk-space-3xs);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-sm);
    font-weight: var(--sk-weight-medium);
    text-decoration: none;
    transition: color var(--sk-duration-fast) var(--sk-ease);
  }

  .l-site-nav-link:hover,
  .l-site-nav-link[aria-current='page'] {
    color: hsl(var(--sk-color-ink));
  }

  .l-site-nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: hsl(var(--sk-color-accent));
    text-decoration-thickness: var(--sk-edge-strong);
    text-underline-offset: 0.45em;
  }

  .l-site-header-actions {
    display: flex;
    align-items: center;
    gap: var(--sk-space-xs);
  }

  @media (max-width: 767px) {
    .l-site-nav-source {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .l-site-header-inner {
      gap: var(--sk-space-sm);
    }

    .l-site-nav {
      gap: var(--sk-space-sm);
    }

    .l-site-nav-link {
      font-size: var(--sk-text-xs);
    }
  }
</style>
