---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../ui/Icon.astro';
import { localeInfo, siteUrl, type Locale } from '../../i18n/config';
import { routes } from '../../site/routes';
import { siteLinks } from '../../site/links';
import { useBrandMessages } from '../i18n/ui';

interface Props {
  locale: Locale;
  featuredHref: string;
}

const { locale, featuredHref } = Astro.props;
const t = useBrandMessages(locale);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Siderkit',
  url: siteUrl,
  inLanguage: localeInfo[locale].htmlLang,
};
---

<BaseLayout
  locale={locale}
  path={routes.home}
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  schema={schema}
>
  <section class="l-home-hero">
    <div class="sk-container l-home-hero-grid">
      <div class="l-home-hero-copy">
        <p class="sk-eyebrow">{t.home.eyebrow}</p>
        <h1 class="l-home-hero-title">{t.home.title}</h1>
        <p class="l-home-hero-lead">{t.home.lead}</p>
        <div class="l-home-hero-actions">
          <a class="sk-button sk-button--primary" href={featuredHref}>
            {t.home.primaryCta}
            <Icon name="arrow-right" size="sm" />
          </a>
        </div>
      </div>

      <div class="l-home-hero-mark" aria-hidden="true">
        <span class="l-home-hero-mark-ring"></span>
        <span class="l-home-hero-mark-tile">S</span>
      </div>
    </div>
  </section>

  <section class="l-home-apps">
    <div class="sk-container">
      <slot name="apps" />
    </div>
  </section>

  <section class="l-home-closing">
    <div class="sk-container l-home-closing-inner">
      <p>{t.home.closingLine}</p>
      <a
        class="sk-text-link l-home-closing-github"
        href={siteLinks.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" size="sm" />
        {t.common.github}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────────── */
  .l-home-hero {
    padding-top: clamp(var(--sk-space-2xl), 6vw, var(--sk-space-4xl));
    padding-bottom: var(--sk-space-3xl);
  }

  .l-home-hero-grid {
    display: grid;
    align-items: center;
    gap: var(--sk-space-3xl);
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }

  .l-home-hero-mark {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    max-width: 20rem;
  width: min(100%, 20rem);
    aspect-ratio: 1;
    container-type: inline-size;
  }

  .l-home-hero-mark-ring {
    position: absolute;
    inset: 0;
    border: var(--sk-edge) solid hsl(var(--sk-color-accent) / 0.4);
    border-radius: var(--sk-radius-full);
  }

  .l-home-hero-mark-ring::after {
    content: '';
    position: absolute;
    inset: 9%;
    border: var(--sk-edge) solid hsl(var(--sk-color-accent) / 0.2);
    border-radius: inherit;
  }

  .l-home-hero-mark-tile {
    display: grid;
    place-items: center;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 30%;
    background: hsl(var(--sk-color-brand));
    color: hsl(var(--sk-color-on-brand));
    font-family: var(--sk-font-body);
    font-size: 34cqw;
    font-weight: var(--sk-weight-bold);
    line-height: var(--sk-leading-none);
    box-shadow: var(--sk-shadow-card);
  }

  @media (max-width: 1023px) {
    .l-home-hero-grid {
      grid-template-columns: 1fr;
    }

    .l-home-hero-mark {
      width: 64%;
  max-width: 18rem;
  width: min(64%, 18rem);
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 639px) {
    .l-home-hero-mark {
      width: 58%;
    }
  }

  .l-home-hero-title {
    margin-top: var(--sk-space-md);
    font-family: var(--sk-font-display);
    font-size: var(--sk-text-hero);
    font-weight: var(--sk-weight-regular);
    letter-spacing: var(--sk-tracking-tight);
    line-height: var(--sk-leading-tight);
    white-space: pre-line;
  }

  .l-home-hero-lead {
    max-width: var(--sk-reading);
    margin-top: var(--sk-space-lg);
    color: hsl(var(--sk-color-muted));
    font-size: var(--sk-text-lg);
    line-height: var(--sk-leading-normal);
    text-wrap: pretty;
  }

  .l-home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sk-space-sm);
    margin-top: var(--sk-space-xl);
  }

  /* ── First app ──────────────────────────────────────────────── */
  .l-home-apps {
    padding-top: var(--sk-space-lg);
    padding-bottom: var(--sk-space-4xl);
  }

  /* ── Closing line ───────────────────────────────────────────── */
  .l-home-closing {
    padding-top: var(--sk-space-lg);
    padding-bottom: var(--sk-space-lg);
    border-top: var(--sk-edge) solid hsl(var(--sk-color-line));
  }

  .l-home-closing-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sk-space-md);
  }

  .l-home-closing-inner p {
    color: hsl(var(--sk-color-muted));
    font-family: var(--sk-font-mono);
    font-size: var(--sk-text-xs);
    letter-spacing: var(--sk-tracking-wide);
  }

  .l-home-closing-github {
    display: inline-flex;
    align-items: center;
    gap: var(--sk-space-xs);
  }
</style>
